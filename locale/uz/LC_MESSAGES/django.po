#, python-format
msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "Parol juda qisqa. U kamida %d ta belgidan iborat bo'lishi kerak."

#, python-format
msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Parol kamida %(min_length)d ta belgidan iborat bo'lishi kerak."

#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Parol «%(verbose_name)s» maydoniga juda o'xshash."

msgid "Your password can’t be too similar to your other personal information."
msgstr "Parol shaxsiy ma'lumotlaringizga juda o'xshash bo'lmasligi kerak."

msgid "This password is too common."
msgstr "Bu parol juda keng tarqalgan, uni osongina taxmin qilish mumkin."

msgid "Your password can’t be a commonly used password."
msgstr "Keng tarqalgan paroldan foydalanib bo'lmaydi."

msgid "This password is entirely numeric."
msgstr "Parol faqat raqamlardan iborat bo'lmasligi kerak."

msgid "Your password can’t be entirely numeric."
msgstr "Parol faqat raqamlardan iborat bo'lmasligi kerak."

msgid "username"
msgstr "foydalanuvchi nomi"

msgid "first name"
msgstr "ism"

msgid "last name"
msgstr "familiya"

msgid "email address"
msgstr "email manzili"

#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Kamida {min_length} ta belgi kiriting."

msgid "This field may not be blank."
msgstr "Bu maydonni to'ldiring."

msgid "The new password must differ from the temporary one."
msgstr "Yangi parol vaqtinchalik paroldan farq qilishi kerak."

msgid "Your account has been temporarily suspended for a security review. Please contact the administrator."
msgstr "Hisobingiz xavfsizlik tekshiruvi uchun vaqtincha to'xtatildi. Administratorga murojaat qiling."
